    "maturity_rating.desc_kids" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gentle and age-appropriate content for early school-age kids. May include fun and educational themes."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เนื้อหาอ่อนโยนและเหมาะสมกับเด็กวัยประถม อาจมีธีมสนุกและให้ความรู้"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကျောင်းစတင်ဝင်သည့် ကလေးများအတွက် သင့်တော်၍ သဘောထားပေါ့ပါးသော အကြောင်းအရာများ ဖြစ်သည်။ ပညာပေးနှင့် ပျော်ရွှင်ဖွယ် သဘောတရားများ ပါဝင်နိုင်သည်။"
          }
        }
      }
    },
