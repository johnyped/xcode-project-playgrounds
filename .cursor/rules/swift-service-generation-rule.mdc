## Remote Service Pattern (`{ServiceName}RemoteService.swift`)

```swift
//
//  {ServiceName}RemoteService.swift
//  YourProject
//
//  Created by AI Assistant
//

import Foundation
import Mockable

@Mockable
protocol {ServiceName}ServiceProtocol: AnyObject {
    func fetch{ServiceName}s(request: {ServiceName}ServiceRequest.Fetch{ServiceName}s) async throws -> Paginator<{ServiceName}>
    func fetch{ServiceName}ById(request: {ServiceName}ServiceRequest.FetchById) async throws -> {ServiceName}
    func create{ServiceName}(request: {ServiceName}ServiceRequest.Create{ServiceName}) async throws -> {ServiceName}
    func delete{ServiceName}(request: {ServiceName}ServiceRequest.Delete{ServiceName}) async throws
}

class {ServiceName}RemoteService: {ServiceName}ServiceProtocol {
    private var localStorage: LocalStorageManagerProtocal
    private let apiManager: APIManagerProtocal
    
    init(localStorage: LocalStorageManagerProtocal = LocalStorageManager(),
         apiManager: APIManagerProtocal = APIManager.shared) {
        self.localStorage = localStorage
        self.apiManager = apiManager
    }
    
    func fetch{ServiceName}s(request: {ServiceName}ServiceRequest.Fetch{ServiceName}s) async throws -> Paginator<{ServiceName}> {
        let router = {ServiceName}ServiceRouter.fetch{ServiceName}s(request: request)
        return try await apiManager.request(router: router, requiredAuthorization: true)
    }
    
    func fetch{ServiceName}ById(request: {ServiceName}ServiceRequest.FetchById) async throws -> {ServiceName} {
        let router = {ServiceName}ServiceRouter.fetch{ServiceName}ById(request: request)
        return try await apiManager.request(router: router, requiredAuthorization: true)
    }
    
    func create{ServiceName}(request: {ServiceName}ServiceRequest.Create{ServiceName}) async throws -> {ServiceName} {
        let router = {ServiceName}ServiceRouter.create{ServiceName}(request: request)
        return try await apiManager.request(router: router, requiredAuthorization: true)
    }
    
    func delete{ServiceName}(request: {ServiceName}ServiceRequest.Delete{ServiceName}) async throws {
        let router = {ServiceName}ServiceRouter.delete{ServiceName}(request: request)
        try await apiManager.requestACK(router: router, requiredAuthorization: true)
    }
}
```

## Router Pattern (`{ServiceName}ServiceRouter.swift`)

```swift
//
//  {ServiceName}ServiceRouter.swift
//  YourProject
//
//  Created by AI Assistant
//

import Alamofire
import Foundation

enum {ServiceName}ServiceRouter: AlamofireBaseRouterProtocol {
    case fetch{ServiceName}s(request: {ServiceName}ServiceRequest.Fetch{ServiceName}s)
    case fetch{ServiceName}ById(request: {ServiceName}ServiceRequest.FetchById)
    case create{ServiceName}(request: {ServiceName}ServiceRequest.Create{ServiceName})
    case delete{ServiceName}(request: {ServiceName}ServiceRequest.Delete{ServiceName})

    var domain: String {
        return AppConfiguration.shared.baseURL
    }

    var path: String {
        switch self {
        case .fetch{ServiceName}s:
            return "/v4/{service-name-plural}"
        case .fetch{ServiceName}ById(let request):
            return "/v4/{service-name-plural}/\(request.id)"
        case .create{ServiceName}:
            return "/v4/{service-name-plural}"
        case .delete{ServiceName}(let request):
            return "/v4/{service-name-plural}/\(request.id)"
        }
    }

    var method: Alamofire.HTTPMethod {
        switch self {
        case .fetch{ServiceName}s, .fetch{ServiceName}ById:
            return .get
        case .create{ServiceName}:
            return .post
        case .delete{ServiceName}:
            return .delete
        }
    }

    var headers: [String: String]? {
        return [
            "Content-Type": "application/json"
        ]
    }

    var parameters: [String: Any]? {
        switch self {
        case .fetch{ServiceName}s(let request):
            return request.parameters
        default:
            return nil
        }
    }

    var body: Data? {
        switch self {
        case .create{ServiceName}(let request):
            return request.body
        default:
            return nil
        }
    }

    func asURLRequest() throws -> URLRequest {
        guard let url = URL(string: domain + path) else {
            throw APIError.invalidURL
        }
        let encoding: ParameterEncoding = (method == .get) ? URLEncoding.default : JSONEncoding.default
        var request = URLRequest(url: url)
        request.httpMethod = method.rawValue
        request.httpBody = body
        headers?.forEach { request.addValue($0.value, forHTTPHeaderField: $0.key) }
        return try encoding.encode(request, with: parameters)
    }
}
```

## Test Patterns

### Request Tests (`{ServiceName}ServiceRequestTests.swift`)

```swift
//
//  {ServiceName}ServiceRequestTests.swift
//  YourProjectTests
//
//  Created by AI Assistant
//

import XCTest

class {ServiceName}ServiceRequestTests: XCTestCase {
    
    // MARK: - Fetch{ServiceName}s Tests
    
    func test_fetch{ServiceName}s_withAllParameters_correctSerialization() throws {
        // Arrange
        let request = {ServiceName}ServiceRequest.Fetch{ServiceName}s(
            hotelId: 105,
            page: 1,
            perPage: .twenty,
            sortedBy: .id,
            sortedOrder: .ascending
        )
        
        // Act
        let parameters = request.parameters
        
        // Assert
        XCTAssertNotNil(parameters)
        XCTAssertEqual(parameters?["hotel_id"] as? Int, 105)
        XCTAssertEqual(parameters?["page"] as? Int, 1)
        XCTAssertEqual(parameters?["per_page"] as? String, "20")
        XCTAssertEqual(parameters?["sorted_by"] as? String, "ID")
        XCTAssertEqual(parameters?["sorted_order"] as? String, "ASC")
    }
    
    func test_fetch{ServiceName}s_withMinimalParameters_correctSerialization() throws {
        // Arrange
        let request = {ServiceName}ServiceRequest.Fetch{ServiceName}s(
            hotelId: 105,
            page: nil,
            perPage: nil,
            sortedBy: nil,
            sortedOrder: nil
        )
        
        // Act
        let parameters = request.parameters
        
        // Assert
        XCTAssertNotNil(parameters)
        XCTAssertEqual(parameters?["hotel_id"] as? Int, 105)
        XCTAssertNil(parameters?["page"])
        XCTAssertNil(parameters?["per_page"])
        XCTAssertNil(parameters?["sorted_by"])
        XCTAssertNil(parameters?["sorted_order"])
    }
}
```

### Remote Service Tests (`{ServiceName}RemoteServiceTests.swift`)

```swift
//
//  {ServiceName}RemoteServiceTests.swift
//  YourProjectTests
//
//  Created by AI Assistant
//

import XCTest
import Mockable

class {ServiceName}RemoteServiceTests: XCTestCase {
    
    var sut: {ServiceName}RemoteService!
    var mockAPIManager: MockAPIManagerProtocal!
    var mockLocalStorage: MockLocalStorageManagerProtocal!
    
    override func setUp() {
        super.setUp()
        mockAPIManager = MockAPIManagerProtocal()
        mockLocalStorage = MockLocalStorageManagerProtocal()
        sut = {ServiceName}RemoteService(localStorage: mockLocalStorage, apiManager: mockAPIManager)
    }
    
    override func tearDown() {
        sut = nil
        mockAPIManager = nil
        mockLocalStorage = nil
        super.tearDown()
    }
    
    // MARK: - Test fetch{ServiceName}s
    
    func test_fetch{ServiceName}s_success() async throws {
        // Arrange
        let request = {ServiceName}ServiceRequest.Fetch{ServiceName}s(
            hotelId: 105,
            page: 1,
            perPage: .twenty,
            sortedBy: .id,
            sortedOrder: .ascending
        )
        
        let expected{ServiceName}s = createMock{ServiceName}sPaginator()
        
        given(mockAPIManager)
            .request(router: .any, requiredAuthorization: .any)
            .willReturn(expected{ServiceName}s)
        
        // Act
        let result = try await sut.fetch{ServiceName}s(request: request)
        
        // Assert
        XCTAssertEqual(result.totalItems, expected{ServiceName}s.totalItems)
        XCTAssertEqual(result.items.first?.id, expected{ServiceName}s.items.first?.id)
        
        verify(mockAPIManager)
            .request(router: .any, requiredAuthorization: .value(true))
            .called(1)
    }
    
    func test_fetch{ServiceName}s_failure() async throws {
        // Arrange
        let request = {ServiceName}ServiceRequest.Fetch{ServiceName}s(
            hotelId: 105,
            page: 1,
            perPage: .twenty,
            sortedBy: .id,
            sortedOrder: .ascending
        )
        
        let error = APIError.unknownError(title: "Stub Error", subtitle: nil, underlying: nil)
        given(mockAPIManager)
            .request(router: .any, requiredAuthorization: .any)
            .willProduce { (a,b) -> Paginator<{ServiceName}> in
                throw error
            }
        
        // Act & Assert
        do {
            _ = try await sut.fetch{ServiceName}s(request: request)
            XCTFail("Expected error to be thrown")
        } catch {
            switch error as? APIError {
            case .unknownError(let title, _, _):
                XCTAssertEqual(title, "Stub Error")
            default:
                XCTFail("Unexpected error type")
            }
        }
        
        verify(mockAPIManager)
            .request(router: .any, requiredAuthorization: .value(true))
            .called(1)
    }
    
    // MARK: - Helper Methods
    
    private func createMock{ServiceName}sPaginator() -> Paginator<{ServiceName}> {
        let {serviceName}s = [createMock{ServiceName}()]
        return Paginator(
            items: Collection(array: {serviceName}s),
            totalItems: 1,
            totalPages: 1,
            perPage: 20,
            page: 1
        )
    }
    
    private func createMock{ServiceName}() -> {ServiceName} {
        return {ServiceName}(
            id: 1,
            // Add required fields with realistic mock data
            hotelId: 105,
            createdAt: Date(),
            updatedAt: Date()
        )
    }
}
```

